{
  "manifest_version": 3,
  "name": "Gamify Timer",
  "version": "1.0.0",
  "description": "Pomodoro timer that earns Focus Credits for guilt-free indulgences",
  "permissions": ["storage", "alarms", "notifications", "offscreen", "nativeMessaging"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [{
    "resources": ["sounds/*"],
    "matches": ["<all_urls>"]
  }]
}
