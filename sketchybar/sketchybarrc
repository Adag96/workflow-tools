#!/bin/bash

# Sizing tokens live in vars.sh (shared with scripts that add items at runtime)
source "$HOME/workflow-tools/sketchybar/vars.sh"

# Set CONFIG_DIR for proper sourcing
CONFIG_DIR="$HOME/workflow-tools/sketchybar"
export CONFIG_DIR

source "$CONFIG_DIR/items/scheme.sh"
get_colors "$(cat "$HOME/.cache/sketchybar/current_scheme")"
source "$CONFIG_DIR/icons.sh"  # Loads all defined icons
# Icons stay full strength: subtle means "inactive" (spaces only), and these controls are always live
export ICON_COLOR=$RIGHT_TEXT_COLOR
source "$CONFIG_DIR/fonts.sh"  # Loads all defined fonts

# This is a demo config to showcase some of the most important commands.
# It is meant to be changed and configured, as it is intentionally kept sparse.
# For a (much) more advanced configuration example see my dotfiles:
# https://github.com/FelixKratz/dotfiles

PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

##### Bar Appearance #####
# Configuring the general appearance of the bar.
# These are only some of the options available. For all options see:
# https://felixkratz.github.io/SketchyBar/config/bar
# If you are looking for other colors, see the color picker:
# https://felixkratz.github.io/SketchyBar/config/tricks#color-picker

sketchybar --bar position=top height=$HEIGHT_L1 color=0x00000000

# Legacy variables for backwards compatibility (now derived from dynamic system)
BAR_HEIGHT=$HEIGHT_L1
BACKGROUND_HEIGHT=$HEIGHT_L2
CORNER_RADIUS=$RADIUS_L2
Y_OFFSET=0

# Export variables so they're available to other scripts
export CORNER_RADIUS

##### Changing Defaults #####
# We now change some default values, which are applied to all further items.
# For a full list of all available item properties see:
# https://felixkratz.github.io/SketchyBar/config/items

default=(
  padding_left=$ITEM_PAD
  padding_right=$ITEM_PAD
  icon.font="$ICON_FONT:Semibold:$FONT_SIZE_TEXT.0"
  label.font="$TEXT_FONT:Semibold:$FONT_SIZE_TEXT.0"
  icon.color=0xffffffff #white
  label.color=0xffffffff #white
  background.color=$PILL_COLOR_4
  background.corner_radius=$CAPSULE_RADIUS
  background.height=$CAPSULE_HEIGHT
  background.drawing=off 
  y_offset=$Y_OFFSET
  icon.padding_left=0
  icon.padding_right=$GAP_ICON_LABEL
  label.padding_left=0
  label.padding_right=0
  icon.y_offset=$GLYPH_LIFT
  label.y_offset=$GLYPH_LIFT
)
sketchybar --default "${default[@]}"

# Clickable icon buttons: a capsule around the icon on hover (handled by plugins/hover.sh).
# The capsule's inner padding is taken out of the item padding, so spacing is unchanged.
hover_button=(
  icon.padding_left=$PADDING_S
  icon.padding_right=$((PADDING_S + ICON_OVERHANG))
  padding_left=$((ITEM_PAD - PADDING_S))
  padding_right=$((ITEM_PAD - PADDING_S))
  background.color=$PILL_COLOR_4
  background.height=$CAPSULE_HEIGHT
  background.corner_radius=$CAPSULE_RADIUS
  background.drawing=off                          # last: setting a color re-enables drawing
)

# Invisible spacer that insets a pill's contents from its rounded end.
# Pills (brackets) include their members' padding, so the edge inset has to be
# a member of the outer pill but NOT of any inner capsule.
pill_edge() {
  sketchybar --add item "$1" "$2" \
             --set "$1" width=$PILL_EDGE padding_left=0 padding_right=0 \
                        icon.drawing=off label.drawing=off background.drawing=off
}

# -- LEFT SIDE ITEMS --
pill_edge left_edge left
source $ITEM_DIR/spaces.sh
source $ITEM_DIR/front_app.sh

# Yabai layout toggle (BSP/Stack) — used constantly, so it stays on the bar
sketchybar --add item yabai_mode left \
           --set yabai_mode "${hover_button[@]}" \
             icon.font="$ICON_FONT:Semibold:$FONT_SIZE_TEXT.0" \
             icon.color=$ICON_COLOR \
             label.drawing=off \
             update_freq=3 \
             script="$PLUGIN_DIR/yabai_mode.sh" \
             click_script="$PLUGIN_DIR/yabai_mode_click.sh; $PLUGIN_DIR/yabai_mode.sh" \
           --subscribe yabai_mode space_change mouse.entered mouse.exited
pill_edge left_end left

# Gamify Timer: its own pill — a clock button that expands into running Pomodoros
source $ITEM_DIR/gamify.sh

# -- RIGHT SIDE ITEMS -- (added right-to-left: first added = rightmost)
pill_edge right_end right

# Controls: one gear that opens a menu of the rarely-used actions (yabai on/off,
# color scheme, reload) so they don't occupy prime bar space. While it's open the gear's
# pressed capsule becomes a folder tab running down into the menu panel (popup on the
# gear itself, right-aligned to it — see MENU_RADIUS), so the two read as one control.
MENU="$PLUGIN_DIR/controls.sh"
MENU_W=$((BASE_UNIT * 50))                          # 200px: fixed row width so hover capsules align
sketchybar --add item controls right \
           --set controls "${hover_button[@]}" \
             popup.align=right \
             popup.y_offset=-$(((HEIGHT_L1 - PILL_HEIGHT) / 2)) \
             popup.height=$PILL_HEIGHT \
             popup.background.drawing=on \
             popup.background.color=$PILL_COLOR_4 \
             popup.background.corner_radius=$MENU_RADIUS \
             icon=$CONTROLS_ICON \
             icon.font="$ICON_FONT:Semibold:$FONT_SIZE_TEXT.0" \
             icon.color=$ICON_COLOR \
             label.drawing=off \
             click_script="$MENU toggle" \
             script="$MENU" \
           --subscribe controls mouse.entered mouse.exited mouse.exited.global

# Menu rows: fixed width, icons on a fixed column so labels align, capsule on hover
menu_row=(
  width=$MENU_W
  icon.font="$ICON_FONT:Semibold:$FONT_SIZE_TEXT.0"
  icon.color=$ICON_COLOR
  icon.width=$((FONT_SIZE_TEXT + PADDING_M))
  icon.padding_left=$PADDING_M
  label.font="$TEXT_FONT:Semibold:$FONT_SIZE_TEXT.0"
  label.color=$RIGHT_TEXT_COLOR
  label.padding_left=$GAP_ICON_LABEL
  padding_left=$PILL_EDGE                           # hover rows inset like capsules in a pill
  padding_right=$PILL_EDGE
  background.color=$PILL_COLOR_3
  background.height=$CAPSULE_HEIGHT
  background.corner_radius=$((MENU_RADIUS - PILL_EDGE))   # concentric with the panel
  background.drawing=off                            # last: setting a color re-enables drawing
  script="$PLUGIN_DIR/hover.sh"
)

sketchybar --add item yabai.toggle popup.controls \
           --set yabai.toggle "${menu_row[@]}" \
             update_freq=30 \
             script="$PLUGIN_DIR/yabai_state_display.sh" \
             click_script="$PLUGIN_DIR/toggle_yabai.sh; $MENU close" \
           --subscribe yabai.toggle mouse.entered mouse.exited

sketchybar --add item color_scheme popup.controls \
           --set color_scheme "${menu_row[@]}" \
             icon=$SCHEME_ICON \
             label="Color scheme: $(cat "$HOME/.cache/sketchybar/current_scheme")" \
             click_script="$MENU close; $PLUGIN_DIR/color_scheme_click.sh" \
           --subscribe color_scheme mouse.entered mouse.exited

sketchybar --add item reload.bar popup.controls \
           --set reload.bar "${menu_row[@]}" \
             icon=$RELOAD_ICON \
             label="Reload bar" \
             click_script="$MENU close; $PLUGIN_DIR/reload_sketchybar.sh" \
           --subscribe reload.bar mouse.entered mouse.exited

# Clock (h:mm AM/PM): time = icon (Heavy, the bar's primary item), AM/PM = label.
# No seconds: SF Pro's proportional digits would visibly wobble every second.
sketchybar --add item clock right \
           --set clock icon.font="$TEXT_FONT:Heavy:$FONT_SIZE_TEXT.0" \
                 icon.color=$RIGHT_TEXT_COLOR \
                 icon.width=$CLOCK_WIDTH \
                 icon.align=right \
                 icon.padding_right=$GAP_ICON_LABEL \
                 label.font="$TEXT_FONT:Semibold:$FONT_SIZE_SECONDARY.0" \
                 label.color=$RIGHT_TEXT_COLOR \
                 label.y_offset=$((GLYPH_LIFT - 1)) \
                 update_freq=10 \
                 script="$PLUGIN_DIR/clock.sh"

# Calendar
sketchybar --add item calendar right  \
           --set calendar  \
             icon=􀉉  \
             icon.color=$ICON_COLOR \
             label="Initial"  \
             label.color=$RIGHT_TEXT_COLOR \
             update_freq=600 \
             script="$PLUGIN_DIR/calendar.sh"

# Right side is added right-to-left, so this reads (left→right): volume, battery, cpu
source $ITEM_DIR/cpu.sh
source $ITEM_DIR/battery.sh
source $ITEM_DIR/volume.sh
pill_edge right_start right

# Now Playing widget: its own pill, just left of the right pill (hidden unless playing)
source $ITEM_DIR/media.sh


# Dynamic space brackets (handles any number of spaces across displays)
source $ITEM_DIR/space_brackets.sh

# Right pill: system info and controls (PILL LEVEL 1)
sketchybar --add bracket right_bracket right_start battery cpu volume volume_icon calendar clock controls right_end \
           --set right_bracket background.color=$PILL_COLOR_1 \
                               background.height=$PILL_HEIGHT \
                               background.corner_radius=$PILL_RADIUS \
                               y_offset=$Y_OFFSET

# Force correct item ordering (survives reloads where items already exist)
# (SPACE_ORDER comes from items/spaces.sh; empty when yabai wasn't running)
if [ -n "$SPACE_ORDER" ]; then
    sketchybar --reorder left_edge $SPACE_ORDER space_separator front_app $SPACE_CONTROL_ITEMS yabai_mode left_end gamify_gap gamify_start $GAMIFY_ITEMS gamify_end
fi

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update

# Apply initial space styling after the config load has fully settled —
# the --update above doesn't fire the spaces_watcher while the config is
# still loading, and running it mid-load races the scheme/item setup
( sleep 1; "$PLUGIN_DIR/space.sh" ) &

